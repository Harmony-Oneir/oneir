# Фрагмент arkvm/BUILD.gn: замените им group("all"), остальное в файле не трогайте.
# Переменные $_ipc и $_tc и локальные цели (:sa_main, :samgr_client, ...)
# определены выше в этом же файле.

# Только ATM и его библиотеки (token_setproc, rdb и пр. подтянутся по зависимостям).
#   prebuilts/build-tools/linux-x86/bin/ninja -C out/arkvm arkvm:atm -w dupbuild=warn
import("//build/ohos.gni")

_tc = "//build/toolchain/ohos:ohos_clang_x86_64"
_graphic_2d = "//foundation/graphic/graphic_2d"


group("atm") {
  deps = [
    "//base/security/access_token/services/accesstokenmanager:accesstoken_manager_service($_tc)",
    "//base/security/access_token/services/common/json_parse:accesstoken_json_parse($_tc)",
  ]
}

group("samgr") {
 deps = [
    "//foundation/systemabilitymgr/samgr/services/samgr/native:samgr($_tc)",
 ]
}

group("hilog") {
 deps = [
    "//base/hiviewdfx/hilog/services/hilogd:hilogd($_tc)",
    "//base/hiviewdfx/hilog/services/hilogtool:hilog($_tc)",
 ]
}

group("hiview") {
  deps = [ 
     "//base/hiviewdfx/hiview:hiview_package($_tc)",
     "//base/hiviewdfx/faultloggerd:faultloggerd_targets($_tc)" 
  ]
}



ohos_executable("oneir_param_service") {
  sources = ["non-native-kernel/src/param_service/init_stubs.c", "non-native-kernel/src/param_service/param_service.cpp" ]


  include_dirs = [
    "//base/startup/init/interfaces/innerkits/include",
    "//base/startup/init/interfaces/innerkits/init_module_engine/include",
    "//base/startup/init/services/init/include",
    "//base/startup/init/services/modules/init_hook",
    "//base/startup/init/services/param/include",
  ]

  deps = [

    "//base/startup/init/interfaces/innerkits:libbegetutil",
    "//base/startup/init/services/log:init_log",
    "//base/startup/init/services/param/base:param_base",
    "//base/startup/init/services/param/linux:param_init",
    "//base/startup/init/services/utils:libinit_utils",
  ]
  external_deps = [ "cJSON:cjson","hilog:libhilog" ]

  install_enable = false
  part_name = "init"
  subsystem_name = "startup"

}



group("param_service") {
  deps = [
     "//base/startup/init/services/begetctl:param",
     ":oneir_param_service($_tc)"
  ]
}



ohos_executable("token_init") {
  sources = [ "non-native-kernel/src/token/token_init.cpp" ]
  external_deps = [ "access_token:libnativetoken","access_token:libtoken_setproc" ]
  install_enable = false
  part_name = "ipc"
  subsystem_name = "communication"
}


group("oneir_token_init") {
  deps = [
     ":token_init($_tc)",
  ]
}

ohos_executable("sa_main") {
  sources = [ "//foundation/systemabilitymgr/safwk/services/safwk/src/main.cpp" ]

  include_dirs = [
    "//foundation/systemabilitymgr/safwk/services/safwk/include",
    "//foundation/systemabilitymgr/safwk/interfaces/innerkits/safwk",
  ]


  deps = [
    "//foundation/systemabilitymgr/safwk/interfaces/innerkits/safwk:system_ability_fwk",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
    "samgr:samgr_common",
  ]

  ldflags = [ "-rdynamic" ]

  install_enable = false
  part_name = "safwk"
  subsystem_name = "systemabilitymgr"
}



group("oneir_graphics") {
  deps = [
    # --- Render Service ---
    # Процесс render_service. Транзитивно тянет librender_service, composer,
    # vsync, hyper_graphic_manager и интерфейсные proxy-библиотеки Display HDI.
    "$_graphic_2d/rosen/modules/render_service:render_service",
    "$_graphic_2d/rosen/modules/render_service_base:librender_service_base",

    # Клиентская часть RS: нужна приложениям и вашим пробникам (surface_probe, ohos_window).
    "$_graphic_2d/rosen/modules/render_service_client:librender_service_client",

    # --- Библиотека отрисовки (Drawing поверх Skia) ---
    # "$_graphic_2d/rosen/modules/2d_graphics:2d_graphics",

  ]
}


group("hdf") {
  deps = [
   "//drivers/hdf_core/adapter/uhdf2/manager:hdf_devmgr",
   "//drivers/peripheral/devhost/host:hdf_devhost",
  ]
}


group("all") {
  deps = [
    ":atm",
    ":sa_main",
  ]
}
